<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAttachmentSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/android:windowBackground"
    android:orientation="vertical"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Handle indicator -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@drawable/popup_menu_background"
        android:backgroundTint="?attr/android:textColorHint" />

    <!-- Take Photo Option -->
    <LinearLayout
        android:id="@+id/optionTakePhoto"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_18sdp"
        android:paddingEnd="@dimen/_18sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_camera"
            app:tint="?attr/android:textColor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:fontFamily="@font/ubuntu"
            android:text="Take photo"
            android:textColor="?attr/android:textColor"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>

    <!-- Add Image Option -->
    <LinearLayout
        android:id="@+id/optionAddImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_18sdp"
        android:paddingEnd="@dimen/_18sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_image"
            app:tint="?attr/android:textColor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:fontFamily="@font/ubuntu"
            android:text="Add image"
            android:textColor="?attr/android:textColor"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>

</LinearLayout>
