<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/background_note"
    android:backgroundTint="?attr/colorSurface"
    android:gravity="center">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete_confirmation"
        android:textColor="?attr/android:textColor"
        android:background="@android:color/transparent"
        android:textSize="20sp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/ubuntu_bold"/>

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sureToDelete"
        android:background="@android:color/transparent"
        android:textColor="?attr/android:textColorHint"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="22dp"
        android:fontFamily="@font/ubuntu"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/negative_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:fontFamily="@font/ubuntu"
            app:cornerRadius="8dp"
            android:textColor="?attr/android:textColor"
            android:backgroundTint="?attr/android:windowBackground"
            app:strokeColor="?attr/android:textColorHint"
            app:strokeWidth="1dp"
            android:layout_marginEnd="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/positive_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move to Bin"
            android:fontFamily="@font/ubuntu"
            app:cornerRadius="8dp"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorAccent"/>
    </LinearLayout>

</LinearLayout>
